# =====================================================================
# fashionpick 환경 변수 (.env 하나로 로컬/서버 공통 관리)
#  - 로컬: 이 파일을 .env 로 복사 후 값 입력
#  - Render: 대시보드 > Environment 에 아래 [Render 필수] 항목을 등록
# =====================================================================

# ---------- App ----------
APP_ENV=development                     # development | production
# [Render 필수] JWT 서명 키 (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- Database ----------
# 비워두면 로컬 SQLite(backend/storage/fashionpick.db) 사용
# [Render 필수] TiDB Cloud: mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/fashionpick
DATABASE_URL=
DB_SSL=true                             # TiDB Cloud는 TLS 필수

# ---------- URL / CORS ----------
# [Render 필수] 허용할 프런트엔드 Origin (콤마 구분)
CORS_ORIGINS=http://localhost:5173,https://fashionpick.netlify.app,https://fashionpick.onrender.com
# OAuth 완료 후 기본 리다이렉트 프런트엔드
FRONTEND_URL=http://localhost:5173
# [Render 필수] OAuth redirect_uri 생성에 쓰는 백엔드 공개 주소
BACKEND_PUBLIC_URL=http://localhost:8000

# ---------- 실제 관리자 (전체 CRUD) ----------
# [Render 필수] /admin/login 에서 이 토큰으로만 실제 관리자 권한을 얻는다 (비워두면 실제 관리자 로그인 비활성)
# 생성: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
ADMIN_EMAIL=owner@fashionpick.dev
ADMIN_NAME=플랫폼 관리자

# ---------- 테스트 계정 간편 로그인 ----------
# 일반 회원 / 테스트 관리자(관리자 화면 조회만 가능, 생성·수정·삭제 차단)
ENABLE_TEST_LOGIN=true
TEST_USER_EMAIL=user@fashionpick.dev
TEST_ADMIN_EMAIL=admin@fashionpick.dev
# 최초 실행 시 생성될 테스트 계정 비밀번호 (영문 대/소문자+숫자+특수문자 8자 이상)
TEST_USER_PASSWORD=Fashion!2026
TEST_ADMIN_PASSWORD=Admin!2026pick

# ---------- 소셜 로그인 (OAuth) ----------
# 각 콘솔에 redirect URI 등록: {BACKEND_PUBLIC_URL}/api/auth/oauth/{google|naver|kakao}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- RPA ----------
RPA_MODE=demo                           # demo(샘플 데이터) | live(실제 수집)
SCHEDULER_ENABLED=true                  # 주기적 RPA 작업 실행 여부
RPA_HEADLESS=true
RPA_REQUEST_DELAY_SEC=2.0               # 요청 간격 제한 (Rate Limit)
RPA_USER_AGENT=fashionpick-bot/1.0 (+https://fsclass-n.github.io/fashionpick/)
# 네이버 데이터랩 쇼핑인사이트 API (https://developers.naver.com)
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=
# Playwright 랭킹 페이지 수집 대상 (JSON 배열) - 이용약관/robots.txt 허용 사이트만 등록
# [{"name":"site","url":"https://...","item_selector":".rank li .keyword","category":"아우터"}]
TREND_SCRAPE_TARGETS=[]
# 도매 사이트 수집 대상 (JSON 배열) - 공급처 허락 범위 내에서만 사용
# [{"name":"도매처","supplier":"공급처명","search_url":"https://.../search?q={keyword}",
#   "item_selector":".item","name_selector":".name","price_selector":".price",
#   "image_selector":"img","link_selector":"a"}]
WHOLESALE_TARGETS=[]

# ---------- 도매 소싱 크롤링 (다나와 · 에누리, requests + BeautifulSoup) ----------
SOURCING_MODE=crawl                     # crawl | demo | playwright(WHOLESALE_TARGETS)
CRAWL_SOURCES=danawa,enuri
CRAWL_DELAY_SEC=3.0                     # robots.txt Crawl-delay 가 더 길면 그 값을 사용 (다나와 10초)
CRAWL_MARKUP=1.15                       # 수집 최저가 대비 판매가 배수
CRAWL_PER_KEYWORD=7                     # 키워드·사이트당 상품 수 (전 카테고리 43개 키워드 × 2개 사이트)
CRAWL_MAX_TOTAL=600                     # 1회 수집 상한
CRAWL_AUTO_REGISTER=140                 # 카테고리별로 고르게 자동 판매 등록할 상품 수
SHOP_HIDE_DEMO=true                     # 실제 상품이 있으면 데모 실루엣 상품 숨김

# ---------- 모의 결제 (토스페이먼츠 테스트 키 + 무통장입금) ----------
# 비우면 토스 공식 문서의 공개 테스트 키(test_gck_docs / test_gsk_docs) 사용 → 실제 출금 없음
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
BANK_NAME=패션은행(모의)
BANK_ACCOUNT=000-0000-0000-00
BANK_HOLDER=(주)패션픽
BANK_DUE_HOURS=24

# ---------- 주문 / 발주 ----------
AUTO_PURCHASE_ORDER=true                # 주문 발생 시 발주서 자동 생성
AUTO_SEND_PURCHASE_ORDER=false          # 생성 즉시 공급처로 자동 발송
DEFAULT_MARKUP=2.2                      # 도매가 대비 예상 판매가 배수
ORDER_WEBHOOK_SECRET=                   # 외부 쇼핑몰 주문 웹훅 검증용 (X-Webhook-Secret)
STORE_NAME=fashionpick
STORE_MANAGER=박미금
STORE_PHONE=02-0000-0000
STORE_ADDRESS=서울특별시

# ---------- 알림 (메일 / 웹훅) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- Frontend (Vite, 빌드 시점 주입) ----------
VITE_API_BASE_URL=http://localhost:8000
# 푸터 SNS 링크 (비우면 '준비 중'으로 표시)
VITE_SNS_INSTAGRAM=
VITE_SNS_YOUTUBE=
VITE_SNS_KAKAO=
